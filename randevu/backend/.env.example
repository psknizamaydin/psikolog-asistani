ADMIN_PASSWORD=ChangeThisPassword123!
BUSINESS_EMAIL=owner@example.com
FRONTEND_URL=http://localhost:5173
ENABLE_WORKER=true
# console: logs only; smtp: real e-mail
MAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_FROM=randevu@example.com
SMTP_USER=
SMTP_PASSWORD=
