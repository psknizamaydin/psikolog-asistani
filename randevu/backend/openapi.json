  "components": {
    "schemas": {
      "Booking": {
        "properties": {
          "service_id": {
            "type": "integer",
            "title": "Service Id"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          }
        },
        "type": "object",
        "required": [
          "service_id",
          "start"
        ],
        "title": "Booking"
      },
      "Change": {
        "properties": {
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "title": "Change"
      },
      "CustomerEdit": {
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 30,
            "title": "Phone"
          },
          "notes": {
            "type": "string",
            "maxLength": 5000,
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "phone",
          "notes"
        ],
        "title": "CustomerEdit"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hours": {
        "properties": {
          "day": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Day"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "break_start": {
            "type": "string",
            "title": "Break Start",
            "default": ""
          },
          "break_end": {
            "type": "string",
            "title": "Break End",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "day",
          "start",
          "end"
        ],
        "title": "Hours"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "Register": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 10,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "title": "Phone",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name"
        ],
        "title": "Register"
      },
      "ServiceIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "duration": {
            "type": "integer",
            "maximum": 480.0,
            "minimum": 15.0,
            "title": "Duration"
          },
          "price": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Price"
          }
        },
        "type": "object",
        "required": [
          "name",
          "duration",
          "price"
        ],
        "title": "ServiceIn"
      },
      "SettingsIn": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Istanbul"
          },
          "cancel_hours": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 0.0,
            "title": "Cancel Hours"
          },
          "reminder_minutes": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Reminder Minutes"
          },
          "template": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Template"
          },
          "business_email": {
            "type": "string",
            "format": "email",
            "title": "Business Email"
          },
          "hours": {
            "items": {
              "$ref": "#/components/schemas/Hours"
            },
            "type": "array",
            "title": "Hours"
          },
          "holidays": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Holidays"
          }
        },
        "type": "object",
        "required": [
          "cancel_hours",
          "reminder_minutes",
          "template",
          "business_email",
          "hours",
          "holidays"
        ],
        "title": "SettingsIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}